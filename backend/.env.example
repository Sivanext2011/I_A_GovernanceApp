# Azure AD Configuration (optional - only needed for device code flow)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=

# Manual Graph API token from https://developer.microsoft.com/en-us/graph/graph-explorer
# 1. Go to Graph Explorer, sign in, consent to Mail.Send permission
# 2. Copy the access token and paste below
# Note: Token expires in ~1 hour, replace when expired
GRAPH_ACCESS_TOKEN=

# Optional
APP_DEBUG=false
